# Sino hub settings. Names only: copy to .env (gitignored) or export them in the shell.
# Every setting is optional and has a default in the code. Uncomment and fill in only what you change:
# an empty value is not the same as leaving it out. No API keys: Sino uses no cloud service at runtime.

# ---- Decision engine (brain/) ----
# SINO_MODEL=            # "stub" (default, rules + matcher only) or "ollama" (adds Qwen for unclear lines)
# HUB_URL=               # Ollama address for the model
# SINO_SEED=             # questions file decide() reads (brain/server.py sets it to the hub's working copy)
# SINO_LOG=              # where decisions are logged (JSONL)
# MEAL_WINDOW_H=         # hours a "Kumain na" tap counts as a recent meal

# ---- Hub server (brain/server.py, hub/) ----
# HOST=                  # address the hub server listens on
# PORT=                  # hub server port
# CERT=                  # HTTPS certificate file (mkcert)
# KEY=                   # HTTPS key file (mkcert)
# HUB_DATA=              # hub's working data folder (questions, media)
# CAREGIVER_DIST=        # built caregiver screen folder
# OFFLINE_PROBE=         # public address the OFFLINE check tries to reach
# CHIME=                 # set to 0 to turn the urgent chime off
# HUB=                   # hub address for the fake-hub test helper (brain/tests/fake_hub.py)

# ---- Listening (hub/listen.py) ----
# MIC_DEVICE=            # ffmpeg microphone device
# WHISPER_HINT=          # set to 1 to give Whisper a prompt hint (off by default)
# LISTEN_SECONDS=        # length of a listen-now recording, in seconds
# QUIET_DBFS=            # clips quieter than this loudness are dropped as too quiet

# ---- Whisper (speech to text) ----
# WHISPER_DIR=           # whisper.cpp folder (hub/start.sh)
# WHISPER_MODEL=         # Whisper model file
# WHISPER_BIN=           # whisper-cli binary (brain/tests/run_t5.py --audio)
# VAD_MODEL=             # Silero voice detection model file

# ---- hub/start.sh ----
# PY=                    # Python with the hub packages (FastAPI, uvicorn)
# RUN_DIR=               # PID files of what start.sh started
# LOG_DIR=               # one log file per hub part

# ---- Add-ons (only if they ship) ----
# FACE_THRESHOLD=        # face match: lowest score that counts as a match
# FACE_THRESHOLD_HIGH=   # face match: score for a confident match
# CLIP_MEDIA=            # folder of recorded clips for "Nasaan si Lola?"
# CLIP_HOG_MIN=          # person-detector minimum score for clips
